# Copy to .env for local development.

PORT=5000
NODE_ENV=development

# Leave MONGODB_URI empty in development to use the embedded database
# (mongodb-memory-server, persisted in ./data/db).
# REQUIRED in production (use MongoDB Atlas, see README).
MONGODB_URI=

# Long random string. Generate: node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=change-me-in-production

# Editor account created automatically on first start
ADMIN_EMAIL=editor@chronicle.test
ADMIN_PASSWORD=ChangeMe123!

# Comma-separated list of allowed frontend origins (no trailing slash)
CLIENT_ORIGIN=http://localhost:5173
# Set true to also allow any https://*.vercel.app preview deployment
ALLOW_VERCEL_PREVIEWS=false
